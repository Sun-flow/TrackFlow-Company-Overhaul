{
  "name": "@trackflow/warehouse-logic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "description": "TrackFlow's warehouse and carrier logic layer: typed, pure TypeScript functions over the Milestone 2 data model",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "demo": "node src/demo.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
